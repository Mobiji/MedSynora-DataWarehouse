/*
=======================================================================================================================================================================
		LOADING THE GOLD LAYER (msgold)
=======================================================================================================================================================================
Script Purpose:
    * The query block is made up of a stored procedure that is responsible for loading the gold layer with end user ready data.
    * The objects in the gold layer are views.
	* The stored procedure performs the ETL (Extract, Transform & Load) process to populate the gold layer with data that is ready for analysis or ad-hoc queries.
	* For each view, I have used the 'create or replace view' statement in order to replace the view's content everytime the stored procedure is invoked.
	* The stored procedure does not contain any variables nor parameters. 

How to utilize the query block:
	* Execute the following query [call msgold.load_gold;]
    * To re-define the Gold layer, first execute the query [drop view if exists......] then execute the query [drop procedure if exists msgold.load_gold;].
    * Then execute the 'create procedure' query below.
    * Finally call the procedure by executing the query [call msgold.load_gold;].
    
Warnings: Nil.
*/

drop view if exists msgold.dim_patient,
					msgold.dim_allergy,
                    msgold.dim_chronic_disease,
                    msgold.dim_insurance_packages,
                    msgold.dim_insurance_details,
                    msgold.dim_room,
                    msgold.dim_doctor,
                    msgold.dim_disease,
                    msgold.fact_lab_tests,
                    msgold.fact_vitals,
                    msgold.dim_encounter_additional_service,
                    msgold.fact_encounter,
                    msgold.fact_cost,
                    msgold.fact_treatment,
                    msgold.fact_special_tests;


drop procedure if exists msgold.load_gold;
call msgold.load_gold;

delimiter $$
create procedure msgold.load_gold()

begin
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 1. Creating a view for the dimension for patient information.

create or replace view msgold.dim_patient as
select
		Patient_ID patient_id,
        `First Name` first_name,
        `Last Name` last_name,
        Nationality nationality,
        Gender gender,
        `Birth Date` birth_date,
        Weight weight,
        Height height,
        `Marital Status` marital_status,
        `Blood Type` blood_type
from mssilver.erp_dimpatient;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 2. Creating a view for the fact for the various allergies that each patient had.

create or replace view msgold.dim_allergy as
select
		LT.Patient_ID patient_id,
        DP.`First Name` first_name,
		DP.`Last Name` last_name,
        LT.AllergyName allergy
from
(
	select
			PA.Patient_ID,
			DA.AllergyName
	from mssilver.erp_patient_allergy PA
	left join mssilver.erp_dimallergy DA
		on PA.AllergyID = DA.AllergyID
) LT

left join mssilver.erp_dimpatient DP
	on LT.Patient_ID = DP.Patient_ID;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 3. Creating a view for the fact for the various chronic diseases that a patient had.

create or replace view msgold.dim_chronic_disease as
select
		LT.Patient_ID patient_id,
        DP.`First Name` first_name,
		DP.`Last Name` last_name,
        LT.ChronicDiseaseName chronic_disease
from
(
	select
		PCD.Patient_ID,
		DCD.ChronicDiseaseName
	from mssilver.erp_patient_chronicdisease PCD
	left join mssilver.erp_dimchronicdisease DCD
		on PCD.ChronicDiseaseID = DCD.ChronicDiseaseID
) LT

left join mssilver.erp_dimpatient DP
	on LT.Patient_ID = DP.Patient_ID;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 4. Creating a view for the dimension for conditions that are partially covered.

create or replace view msgold.dim_insurance_packages as

select
		`Conditions Partially Covered` conditions_partially_covered,
        Basic basic,
        Standard standard,
        Premium premium
from mssilver.erp_diminsurancepackages;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 5. Creating a view for the dimension for the various insurance packages that are offered.

create or replace view msgold.dim_insurance_details as

select
		InsuranceKey insurance_id,
        `Insurance Plan Name` Insurance_type,
        concat(round((`Coverage Limit` * 100), 0), '%') extent_of_coverage, -- to convert it from a decimal to a percentage.
        Deductible deductible
from mssilver.erp_diminsurancedetails;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 6. Creating a view for the dimension for the various rooms that are offered.

create or replace view msgold.dim_room as

select
		RoomKey room_id,
        Care_Level care_level,
        `Room Type` room_type
from mssilver.erp_dimroom;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 7. Creating a view for the dimension for the various doctors who work in the medical centre.

create or replace view msgold.dim_doctor as

select
		Doctor_ID doctor_id,
        `Doctor Title` title,
        `Doctor Name` first_name,
        `Doctor Surname` surname,
        `Doctor Nationality` nationality,
        `Medical Unit` medical_unit,
        `Max Patient Count`patients_treated
from mssilver.erp_dimdoctor;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 8. Creating a view for the dimension for the various diseases that have ever been encountered at the medical centre.

create or replace view msgold.dim_disease as

select
		Disease_ID disease_id,
        `Admission Diagnosis` admission_diagnosis,
        `Disease Type` disease_type,
        `Medical Unit` medical_unit,
        `Disease Severity` disease_severity
from mssilver.erp_dimdisease;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 9. Creating a view for the fact for the various labtests conducted on patients who came to the medical centre.

create or replace view msgold.fact_lab_tests as

select
		Encounter_ID encounter_id,
        Patient_ID patient_id,
        Phase phase,
        concat(round((`RBC (10^6/µl) (CBC)` * 1000000), 0), '/µl') `red_blood_cells_count`,
		concat(`Hemoglobin (g/dl) (CBC)`, 'g/dl') `hemoglobin_count`,
		concat(`Hematocrit (%) (CBC)`, '%') `hematocrit_count`,
		concat(`MCH (pg) (CBC)`, 'pg') `haemoglobin_protein_count`,
		concat(`MCHC (g/dl) (CBC)`, 'g/dl') `haemoglobin_concentration`,
		concat(`RDW (%) (CBC)`, '%') `red_blood_cell_variation`,
		concat((`Platelets (10^3/µl) (CBC)` * 1000), '/µl') `platelets_count`,
		concat(round((`WBC (10^3/µl) (CBC)` * 1000), 0), '/µl') `leukocytes_count`,
		concat(round((`Neutrophils_abs (10^3/µl) (CBC)` * 1000), 0), '/µl') `neutrophil_count`,
		concat(round((`Lymphocytes_abs (10^3/µl) (CBC)` * 1000), 0), '/µl') `lymphocytes_count`,
		concat(round((`Monocytes_abs (10^3/µl) (CBC)` * 1000), 0), '/µl') `monocytes_count`,
		concat(round((`Eosinophils_abs (10^3/µl) (CBC)` * 1000), 0), '/µl') `eosinophils_count`,
		concat(round((`Basophils_abs (10^3/µl) (CBC)` * 1000), 0), '/µl') `basophils_count`,
		concat(`Glucose (mg/dl) (Chem)`, 'mg/dl') `blood_sugar_concentration`,
		concat(`BUN (mg/dl) (Chem)`, 'mg/dl') `urea_nitrogen_concentration`,
		concat(`Creatinine (mg/dl) (Chem)`, 'mg/dl') `creatinine_levels`,
		concat(`eGFR (ml/min/1.73m^2) (Chem)`, 'ml/min/1.73m^2') `kidney_filtering_capability`,
		concat(`Sodium (mEq/l) (Chem)`, 'mEq/l') `sodium_ions_count`,
		concat(`Potassium (mEq/l) (Chem)`, 'mEq/l') `potassium_ions_count`,
		concat(`Chloride (mEq/l) (Chem)`, 'mEq/l') `chloride_ions_count`,
		concat(`Total_protein (g/dl) (Chem)`, 'g/dl') `total_protein_amount`,
		concat(`Albumin (g/dl) (Chem)`, 'g/dl') `albumin_amount`,
		concat(`Uric_acid (mg/dl) (Chem)`, 'mg/dl') `uric_acid_amount`,
		concat(`ALT (U/l) (Chem)`, 'U/l') `alanine_aminotransferase`,
		concat(`AST (U/l) (Chem)`, 'U/l') `aspartate_aminotransferase`,
		concat(`ALP (U/l) (Chem)`, 'U/l') `alkaline_phosphatase`,
		concat(`GGT (U/l) (Chem)`, 'U/l') `gamma-glutamyl_transferase`,
		concat(`Total_bilirubin (mg/dl) (Chem)`, 'mg/dl') `bilirubin_amount`,
		concat(`TotalCholesterol (mg/dl) (Lipids)`, 'mg/dl') `cholesterol_amount`,
		concat(`LDL (mg/dl) (Lipids)`, 'mg/dl') `low_density_lipoprotein_amount`,
		concat(`HDL (mg/dl) (Lipids)`, 'mg/dl') `high_density_lipoprotein_amount`,
		concat(`Triglycerides (mg/dl) (Lipids)`, 'mg/dl') `triglycerides_amount`,
		concat(`ApoB (mg/dl) (Lipids)`, 'mg/dl') `apolipoprotein_B-100_amount`,
		concat(`CRP (CRP)`, 'mg/l') `inflammation_levels`
from mssilver.erp_factlabtests
limit 10;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 10. Creating a view for the fact for the various vitals that were checked on the patients who came to the medical centre.

create or replace view msgold.fact_vitals as

select
		Encounter_ID encounter_id,
        Patient_ID patient_id,
        Phase stage,
        HeartRate heart_rate,
        Temperature temperature,
        SystolicBP systolic_blood_pressure,
        DiastolicBP diastolic_blood_pressure,
        RespRate respiratory_rate,
        O2Sat oxygen_saturation
from mssilver.erp_factvitals;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 11. Creating a view for the dimension for the additional services that each patient received while admitted.

create or replace view msgold.dim_encounter_additional_service as

select
		BEAS.Encounter_ID encounter_id,
        DAS.ServiceName service_name
from mssilver.erp_bridgeencounteradditionalservice BEAS
left join mssilver.erp_dimadditionalservice DAS
	on BEAS.AdditionalServiceID = DAS.AdditionalServiceID;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 12. Creating a view for the fact for the encounters that each patient created for their stay at the centre.

create or replace view msgold.fact_encounter as

select
		Encounter_ID encounter_id,
        Patient_ID patient_id,
        Disease_ID disease_id,
        ResponsibleDoctorID doctor_responsible_id,
        InsuranceKey insurance_id,
        RoomKey room_id,
        der_CheckinDate date_of_checkin,
        der_CheckinTime time_of_checkin,
        der_CheckoutDate date_of_checkout,
        der_CheckoutTime time_of_checkout,
        -- CheckinDateKey, -- filtered this row out because the table it can connect to is not really important(mssilver.erp_dimdate) in the gold layer.
        -- CheckoutDateKey, -- filtered this row out because the table it can connect to is not really important(mssilver.erp_dimdate) in the gold layer.
        Patient_Severity_Score patient_severity_score,
        RadiologyType radiology_type,
        RadiologyProcedureCount radiology_procedure_count,
        EndoscopyType endoscopy_type,
        EndoscopyProcedureCount endoscopy_procedure_count,
        case 	when CompanionPresent = 'False' then 'No' -- mapping out values to friendlier values.
				when CompanionPresent = 'True' then 'Yes'
                else 'n/a'
		end CompanionPresent
from mssilver.erp_factencounter;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 13. Creating a view for the fact for the various costs that each patient incurred for their encounter at the centre.

create or replace view msgold.fact_cost as

with cte_name as
(
select
		Encounter_ID,
        round(DrugCost, 0) DrugCost,
        round(SurgeryCost, 0) SurgeryCost,
        round(PostSurgeryCare, 0) PostSurgeryCare,
        round(EducationRehab, 0) EducationRehab, 
        round(PsychologicalSupport, 0) PsychologicalSupport, 
        round(RoomCost, 0) RoomCost,
        round(CompanionAccommodation, 0) CompanionAccommodation,
        round(NutritionCost, 0) NutritionCost,
        round(RadiologyCost, 0) RadiologyCost,
        round(EndoscopyCost, 0) EndoscopyCost,
        round(CBC_Cost, 0) CBC_Cost,
        round(Chem_Cost, 0) Chem_Cost,
        round(Lipid_Cost, 0) Lipid_Cost,
        round(AdditionalInsuranceFees, 0) AdditionalInsuranceFees,
		(round(DrugCost, 0) + round(SurgeryCost, 0) + round(PostSurgeryCare, 0) +	round(EducationRehab, 0) + round(PsychologicalSupport, 0) +
			round(RoomCost, 0) + round(CompanionAccommodation, 0) +	round(NutritionCost, 0) + round(RadiologyCost, 0) +	round(EndoscopyCost, 0) +
            round(CBC_Cost, 0) + round(Chem_Cost, 0) + round(Lipid_Cost, 0) + round(AdditionalInsuranceFees, 0)) TotalCost, -- re-calculating the column 'Total_cost'.
        round(InsuranceCoverage, 0) InsuranceCoverage,
        OutOfPocketCost
from mssilver.erp_factcost
)

select
	Encounter_ID encounter_id,
	DrugCost drug_cost,
	SurgeryCost surgery_cost,
	PostSurgeryCare post_surgery_care_cost,
	EducationRehab education_rehab_cost,
	PsychologicalSupport psychological_support_cost,
	RoomCost room_cost,
	CompanionAccommodation companion_accommodation_cost,
	NutritionCost nutrition_cost,
	RadiologyCost radiology_cost,
	EndoscopyCost endoscopy_cost,
	CBC_Cost cbc_cost,
	Chem_Cost chem_cost,
	Lipid_Cost lipid_cost,
	AdditionalInsuranceFees additional_insurance_fees,
	TotalCost total_cost,
	InsuranceCoverage insurance_coverage,
	(TotalCost - InsuranceCoverage) out_of_pocket_cost -- re-calculating the column 'out_of_pocket_cost' given that the column 'total_cost' was previously re-calculated.
from cte_name;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 14. Creating a view for the fact for the treatment that each patient received at the centre.

create or replace view msgold.fact_treatment as

select
		Encounter_ID encounter_id,
        Treatment_Type treatment_type,
        Treatment_Name treatment_name,
        Follow_Up follow_up,
        Complications complications,
        Therapy_Sessions therapy_sessions,
        Drug_Boxes_Used drug_boxes_used,
        Hospital_Drug_Quantity hospital_drug_quantity,
        Discharge_Drug_Quantity discharge_drug_quantity,
        (Drug_Boxes_Used + Hospital_Drug_Quantity + Discharge_Drug_Quantity) total_drug_quantity
from mssilver.erp_facttreatment;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

-- 15. Creating a view for the fact for the special tests that each patient was done for at the centre.

create or replace view msgold.fact_special_tests as

select
		Encounter_ID encounter_id,
        SpecialTest_ID special_test_id,
        Test_Phase stage,
        Test_Name test_name,
        Test_Result result
from mssilver.erp_factspecialtests;
-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

end$$
delimiter ;
