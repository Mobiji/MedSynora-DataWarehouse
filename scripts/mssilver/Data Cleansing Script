/* 
		* Upon taking a closer look at the table, I discovered that EACH distinct Encounter_ID has EXACTLY 17 events/records.
        * This suggests that the table is in the long format hence the huge number of rows (2,513,484).
        * I will convert this table to the wide format where there will be a total of 18 columns and 147,852 total rows.
	Reason: In order to facilitate future joins during report creating.
*/

select
		Encounter_ID,
		max(case when trim(CostType) = 'DrugCost' then CostAmount end) DrugCost,
		max(case when trim(CostType) = 'SurgeryCost' then CostAmount end) SurgeryCost,
		max(case when trim(CostType) = 'PostSurgeryCare' then CostAmount end) PostSurgeryCare,
		max(case when trim(CostType) = 'EducationRehab' then CostAmount end) EducationRehab,
		max(case when trim(CostType) = 'PsychologicalSupport' then CostAmount end) PsychologicalSupport,
		max(case when trim(CostType) = 'RoomCost' then CostAmount end) RoomCost,
		max(case when trim(CostType) = 'CompanionAccommodation' then CostAmount end) CompanionAccommodation,
		max(case when trim(CostType) = 'NutritionCost' then CostAmount end) NutritionCost,
		max(case when trim(CostType) = 'RadiologyCost' then CostAmount end) RadiologyCost,
		max(case when trim(CostType) = 'EndoscopyCost' then CostAmount end) EndoscopyCost,
		max(case when trim(CostType) = 'AdditionalInsuranceFees' then CostAmount end) AdditionalInsuranceFees,
		max(case when trim(CostType) = 'TotalCost' then CostAmount end) TotalCost,
		max(case when trim(CostType) = 'InsuranceCoverage' then CostAmount end) InsuranceCoverage,
		max(case when trim(CostType) = 'OutOfPocketCost' then CostAmount end) OutOfPocketCost,
		max(case when trim(CostType) = 'CBC_Cost' then CostAmount end) CBC_Cost,
		max(case when trim(CostType) = 'Chem_Cost' then CostAmount end) Chem_Cost,
		max(case when trim(CostType) = 'Lipid_Cost' then CostAmount end) Lipid_Cost,
        row_number() over() rrank
from msbronze.erp_factcost
group by Encounter_ID;

/*
	* The above query failed to execute giving 'Error code: 2013. Lost connection to MySQL server during query'.
	* On further investigation, I figured out that the size of the table is what is the problem.
	* On attempting to execute the above query on smaller chunks of the table, the query executes successfully.
	* After testing, I found a sweet spot regarding the size of the chunks (370,000 rows).
	* Beyond that MySQL looses connection to the server.
	* So I'll transpose the data in chunks of 370,000 rows.
	* On trying this, EACH query takes around 28 seconds to execute meaning that it will take a total of (2,513,484 / 370,000) seconds to transpose
		the whole table which seems really inefficient.
	* I had to look for an alternative method which requires less code writing and also less execution time.
*/ 

/*
	* After some back and forth, I consulted AI who enlightened me that the problem was not the size of my dataset but rather, my specific query's execution time 
		exceeded the default wait_timeout system variable limit which is 30 seconds. To fix this, I extended both the 'net_read_timeout' variable on the server side
        and the 'DBMS connection read timeout (in seconds)' on client's side to 600 seconds'.
				Server side: 	1. [SHOW VARIABLES LIKE '%timeout%';] -- scroll down to 'net_read_timeout' and observe what amount is indicated in the 'value' column.
								2. [SET GLOBAL net_read_timeout = 600;] -- Run this query to increase the value observed in the step above.
				Client's side: 1. 	'Edit' → 'Preferences' → 'SQL Editor' → 'DBMS connection read timeout interval (in seconds)' 
									Increase it to more than the indicated amount.
	* After doing the above, I re executed the query above but now without the 370,000 row limit.
    * The query executed successfully taking a total of 68 seconds to execute.
*/

-- So the final cleansed data to be inserted into the mssilver.erp_factcost table will come from:
select
		Encounter_ID,
		max(case when trim(CostType) = 'DrugCost' then trim(CostAmount) end) DrugCost,
		cast(max(case when trim(CostType) = 'SurgeryCost' then trim(CostAmount) end) as decimal(10,2)) SurgeryCost, -- used cast() to reduce number of decimal places. 
		cast(max(case when trim(CostType) = 'PostSurgeryCare' then trim(CostAmount) end) as decimal(10,2)) PostSurgeryCare, -- same to this column.
		max(case when trim(CostType) = 'EducationRehab' then trim(CostAmount) end) EducationRehab,
		max(case when trim(CostType) = 'PsychologicalSupport' then trim(CostAmount) end) PsychologicalSupport,
		max(case when trim(CostType) = 'RoomCost' then trim(CostAmount) end) RoomCost,
		max(case when trim(CostType) = 'CompanionAccommodation' then trim(CostAmount) end) CompanionAccommodation,
		max(case when trim(CostType) = 'NutritionCost' then trim(CostAmount) end) NutritionCost,
		max(case when trim(CostType) = 'RadiologyCost' then trim(CostAmount) end) RadiologyCost,
		max(case when trim(CostType) = 'EndoscopyCost' then trim(CostAmount) end) EndoscopyCost,
		max(case when trim(CostType) = 'AdditionalInsuranceFees' then trim(CostAmount) end) AdditionalInsuranceFees,
		max(case when trim(CostType) = 'TotalCost' then trim(CostAmount) end) TotalCost,
		cast(max(case when trim(CostType) = 'InsuranceCoverage' then trim(CostAmount) end) as decimal(10,2)) InsuranceCoverage, -- same to this column.
		cast(max(case when trim(CostType) = 'OutOfPocketCost' then trim(CostAmount) end) as decimal(10,2)) OutOfPocketCost, -- same to this column.
		max(case when trim(CostType) = 'CBC_Cost' then trim(CostAmount) end) CBC_Cost,
		max(case when trim(CostType) = 'Chem_Cost' then trim(CostAmount) end) Chem_Cost,
		max(case when trim(CostType) = 'Lipid_Cost' then trim(CostAmount) end) Lipid_Cost
from msbronze.erp_factcost
group by Encounter_ID;
