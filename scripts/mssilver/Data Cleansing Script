select *
from msbronze.erp_dimdate;
/*
	* From just a glance of this table, I can see that the table contains various details about a date. i.e. month, day, quarter, weekday etc.
    * So by using the date column, I have to ensure the all the other columns have accurate information as per the date column's contents.
    * And, I can also map some values into more friendlier values i.e. the month column can read the month in string instead of and integer.
    * Also, I can see that the DateKey column is a unique identifier of the date values. And it is mapped from the date value but starting from end to beginning.
		i.e. '1908-01-08' ==> '8011908' (The actual date starting from the end to the start becomes the DateKey which is the primary key of this table).
	* The Date column has been defined as a 'Date' datatype column so invalid dates cannot be inserted into it by default.
	* So the first thing I will do is to check if there are nulls in the Date column or date values that are in the future.(using today (17-02-2026) as a reference). 
    * Then after that I can map out all the other columns' values from the Date column.
*/

-- Test: Checking for nulls or dates that are in the future.
select `Date`
from msbronze.erp_dimdate
where 	`Date` is null
		or Date > date(now());
-- Result: Zero nulls found. There are also no dates that are in the future.
-- _____________________________________________________________________________________________________________________________________________________________________

-- Test: Checking for duplicates.
select 
		`Date`,
		count(*)
from msbronze.erp_dimdate
group by `Date`
having count(*) > 1;
-- Result: Zero duplicates found.
-- _____________________________________________________________________________________________________________________________________________________________________

-- Final cleansed data to be inserted into the mssilver.erp_dimdate table:
select
		`Date`,
        date_format(`Date`, '%d%m%Y') DateKey,
		year(`Date`) `Year`,
		monthname(`Date`) `Month`,
		day(`Date`) `day`,
		case 	when quarter(`Date`) = 1 then '1st'
				when quarter(`Date`) = 2 then '2nd'
                when quarter(`Date`) = 3 then '3rd'
                when quarter(`Date`) = 4 then '4th'
		end `quarter`,
		dayofweek(`Date`) weekday,
		date_format(`Date`, '%d-%m-%Y') Date_String
from msbronze.erp_dimdate;
