        <mxCell id="_RGwDC88Wdcd8SNDBt_c-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=0;fontSize=9;fillColor=#f5f5f5;strokeColor=#666666;gradientColor=#b3b3b3;" value="erp_dimpatient" vertex="1">
